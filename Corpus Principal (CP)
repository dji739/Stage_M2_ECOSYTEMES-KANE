@article{ WOS:001136743600002,
Author = {Hanazaki, Natalia},
Title = {Local and traditional knowledge systems, resistance, and
   socioenvironmental justice},
Journal = {JOURNAL OF ETHNOBIOLOGY AND ETHNOMEDICINE},
Year = {2024},
Volume = {20},
Number = {1},
Month = {JAN 4},
Abstract = {In this essay, for the debate series of Journal of Ethnobiology and
   Ethnomedicine, I argue against the oversimplified causal argument that
   the maintenance of local and traditional knowledge systems is related to
   less advantaged circumstances. This statement is based on a colonialist
   perspective of what a less advantageous circumstance is, which is being
   questioned by several authors. It also ignores the struggles and
   resistance of traditional knowledge holders and the urgent call for
   socioenvironmental justice. As an ethnobiologist, I argue that we must
   face this reality to build science with justice and inclusiveness.},
Publisher = {BMC},
Address = {CAMPUS, 4 CRINAN ST, LONDON N1 9XW, ENGLAND},
Type = {Article},
Language = {English},
