@article{ WOS:001364322300043,
Author = {Yasue, Mai and Weinstein, Netta and Harris, Sara and Chiang, I-Chant and
   Legate, Nicole and Moore, Ashley and Joe, Nadia},
Title = {Embedding equity and inclusion in universities through motivational
   theory and community-based conservation approaches},
Journal = {CONSERVATION BIOLOGY},
Year = {2024},
Volume = {38},
Number = {6},
Month = {DEC},
Abstract = {Despite widespread plans to embed justice, equity, decolonization,
   indigenization, and inclusion (JEDII) into universities, progress toward
   deeper, systemic change is slow. Given that many community-based
   conservation (CBC) scholars have experience creating enduring social
   change in diverse communities, they have transferable skills that could
   help embed JEDII in universities. We synthesized the literature from CBC
   and examined it through the lens of self-determination theory to help
   identify generalizable approaches to create resilient sociocultural
   change toward JEDII in universities. Fostering autonomous motivation
   (i.e., behaving because one truly values and identifies with the
   behavior or finds behavior inherently satisfying) is critical to
   inspiring enduring change in both CBC and JEDII. Based on theory and our
   examination of CBC, we provide 5 broad recommendations that helped
   motivate behavioral change in a way that was self-sustained (i.e., even
   without external rewards or pressure). Guiding principles support
   autonomy by creating meaningful choice and different entry points for
   JEDII; prioritising relationships; designing payment programs that
   enhance autonomous motivation; developing meaningful educational
   opportunities that are relevant, timely, relational, and authentic; and
   creating institutional change by focusing efforts on critical moments.
   Integraci \& oacute;n de la equidad y la inclusi \& oacute;n en las
   universidades por medio de la teor \& iacute;a motivacional y las
   estrategias de conservaci \& oacute;n comunitaria A pesar de los planes
   generalizados para integrar la justicia, la equidad, la descolonizaci \&
   oacute;n, la indigenizaci \& oacute;n y la inclusi \& oacute;n (JEDII)
   en las universidades, el progreso hacia un cambio sist \& eacute;mico m
   \& aacute;s profundo es lento. Muchos acad \& eacute;micos de la
   conservaci \& oacute;n basada en comunidades (CBC) tienen experiencia en
   la creaci \& oacute;n de un cambio social duradero en diversas
   comunidades, por lo que poseen habilidades transferibles que podr \&
   iacute;an ayudar a integrar la JEDII en las universidades. Sintetizamos
   la bibliograf \& iacute;a de la CBC y la analizamos a trav \& eacute;s
   de la lente de la teor \& iacute;a de la autodeterminaci \& oacute;n
   para ayudar a identificar enfoques generalizables para crear un cambio
   sociocultural resistente hacia la JEDII en las universidades. El fomento
   a la motivaci \& oacute;n aut \& oacute;noma (es decir, comportarse
   porque uno realmente valora y se identifica con el comportamiento o
   encuentra el comportamiento inherentemente satisfactorio) es fundamental
   para inspirar un cambio duradero tanto en la CBC como en el JEDII. Con
   base en la teor \& iacute;a y en nuestro examen de la CBC, ofrecemos
   cinco recomendaciones generales que ayudan a motivar el cambio de
   comportamiento de forma autosostenida (es decir, incluso sin recompensas
   o presiones externas). Los principios rectores son apoyar la autonom \&
   iacute;a con la creaci \& oacute;n de opciones significativas y
   diferentes puntos de entrada para JEDII; dar prioridad a las relaciones;
   dise \& ntilde;ar programas de pago que potencien la motivaci \&
   oacute;n aut \& oacute;noma; desarrollar oportunidades educativas
   significativas que sean relevantes, oportunas, relacionales y aut \&
   eacute;nticas; y crear un cambio institucional con los esfuerzos
   enfocados en momentos cr \& iacute;ticos.Integraci \& oacute;n de la
   equidad y la inclusi \& oacute;n en las universidades por medio de la
   teor \& iacute;a motivacional y las estrategias de conservaci \&
   oacute;n comunitaria A pesar de los planes generalizados para integrar
   la justicia, la equidad, la descolonizaci \& oacute;n, la indigenizaci
