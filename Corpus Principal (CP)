@article{ WOS:000588102500001,
Author = {Schottenhammer, Angela},
Title = {``Peruvian balsam{''}: an example of transoceanic transfer of medicinal
   knowledge},
Journal = {JOURNAL OF ETHNOBIOLOGY AND ETHNOMEDICINE},
