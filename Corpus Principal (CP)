@article{ WOS:000901873900002,
Author = {Johns, David and Crist, Eileen and Sahgal, Bittu},
Title = {Ending the domination of nature},
Journal = {BIOLOGICAL CONSERVATION},
Year = {2022},
Volume = {273},
Month = {SEP},
Abstract = {Life on Earth is in precipitous decline due to the behavior of human
   societies. As a species our numbers and consumption have displaced
   countless other species, stealing their habitat and persecuting them
   without limit. We behave toward nature as if it were our colony and
   become outraged when it is suggested that the Earth and its life are not
   ours to subjugate. Yet colonialism does not end well. Conservation is
   failing to check both causes and symptoms of the decline in the rich
   variety of living systems on Earth. It must become much more effective.
   The purpose of these papers is to suggest ways to do so; to
   fundamentally transform human societies as the IPBES says we urgently
   must.},
