@article{ WOS:001060030700001,
Author = {Borokini, Israel T. and Kortz, Alessandra and Anibaba, Quadri A. and
   Witt, Arne and Aigbokhan, Emmanuel I. and Hejda, Martin and Pysek, Petr},
Title = {Alien flora of Nigeria: taxonomy, biogeography, habitats, and ecological
   impacts},
