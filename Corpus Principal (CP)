@article{ WOS:001527981100001,
Author = {Tomaszewski, Dominik and Walas, Lukasz and Guzicka, Marzenna},
Title = {Tracing holotype trajectories: Mapping the movement of the most valuable
   herbarium specimens},
Journal = {PLANTS PEOPLE PLANET},
Year = {2025},
Month = {2025 JUL 10},
Abstract = {Societal Impact StatementGlobal efforts to protect biodiversity depend
   on fair access to key plant specimens. This study examines the
   distribution of 119,361 holotypes-unique herbarium specimens used to
   formally describe new plant species. By linking collection and storage
   data, we found that holotypes are increasingly held closer to their
   places of origin, particularly in Africa, Asia and Latin America. This
   shift reflects postcolonial change, growing local scientific capacity
   and evolving biodiversity governance. Our findings underscore the
   lasting impact of colonial legacies and highlight the urgent need for
   investment in herbaria, improved digitisation and policies that
   strengthen local control over biological resources.Summary This study
   analyses the distribution of holotypes, probably the most important
   specimens in herbaria. Although holotypes represent a small fraction of
   the global collection of plant specimens, they are essential for
   systematic research and species identification. The research aims to
   analyse the spatiotemporal distribution patterns of holotypes and
   understand the dynamics of these patterns. Using publicly available data
   from the GBIF, the study selects holotypes of Tracheophyta and links
   their original collection locations and times to current storage
   locations. Analysis of 119,361 holotype records from 528 herbaria in 88
   countries reveals significant trends in the distribution of holotypes.
   The distance between collection sites and herbaria has decreased over
   time, that is, around 1800, the median distance was 8,800 km, while by
   2000 it decreased to 750 km. In particular, there is a growing trend for
   local retention of holotypes in Africa, Asia and Latin America, along
   with the continued presence of specimens in European and North American
   herbaria from those regions. The study highlights the importance of
   holotypes in botanical research and biodiversity documentation. The
   shifting distribution patterns reflect the historical colonial dynamics
   and recent changes in the local scientific capacity. The research
   underscores the need for global investment in herbarium collections to
   preserve genetic material and document local floral biodiversity,
   especially in biodiversity-rich regions such as Africa, Asia and Central
   \& South America.
   Los esfuerzos globales para proteger la biodiversidad dependen de un
