@article{ WOS:000355749100013,
Author = {Habel, Jan Christian and Teucher, Mike and Hornetz, Berthold and
   Jaetzold, Ralph and Kimatu, Josphert N. and Kasili, Sichangi and
   Mairura, Zachariah and Mulwa, Ronald K. and Eggermont, Hilde and
   Weisser, Wolfgang W. and Lens, Luc},
Title = {Real-world complexity of food security and biodiversity conservation},
Journal = {BIODIVERSITY AND CONSERVATION},
Year = {2015},
Volume = {24},
